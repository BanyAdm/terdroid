#!/bin/bash

set -e
pkg install openjdk-17 -y
pkg install android-tools -y
pkg install gradle -y
pkg install aapt2 -y
pkg install wget -y
pkg install unzip -y

mkdir -p ~/.gradle
echo "android.aapt2FromMavenOverride=$PREFIX/bin/aapt2" >> ~/.gradle/gradle.properties

SDK_DIR="$HOME/android-sdk"
mkdir -p "$SDK_DIR"

echo "==> Downloading Command-Line Tools..."
wget -q https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip -O cmdline-tools.zip

echo "==> Extracting Command-Line Tools..."
unzip -q cmdline-tools.zip -d "$SDK_DIR"
rm cmdline-tools.zip

echo "==> Downloading Platform Tools..."
wget -q https://dl.google.com/android/repository/platform-tools-latest-linux.zip -O platform-tools.zip
echo "==> Extracting Platform Tools..."
unzip -q platform-tools.zip -d "$SDK_DIR"
rm platform-tools.zip

# Paths to add
CMDLINE_PATH="$SDK_DIR/cmdline-tools/bin"
PLATFORM_PATH="$SDK_DIR/platform-tools"

# Export ANDROID_HOME and PATH for current session
export ANDROID_HOME="$SDK_DIR"
export PATH="$CMDLINE_PATH:$PLATFORM_PATH:$PATH"

# Append to shell configs
for file in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile"; do
    if [ -f "$file" ]; then
        grep -qxF "export ANDROID_HOME=$SDK_DIR" "$file" || echo "export ANDROID_HOME=$SDK_DIR" >> "$file"
        grep -qxF "export PATH=\$ANDROID_HOME/cmdline-tools/bin:\$ANDROID_HOME/platform-tools:\$PATH" "$file" || \
            echo "export PATH=\$ANDROID_HOME/cmdline-tools/bin:\$ANDROID_HOME/platform-tools:\$PATH" >> "$file"
    fi
done

echo "==> Accepting SDK Licenses..."
yes | "$CMDLINE_PATH/sdkmanager" --sdk_root="$ANDROID_HOME" --licenses > /dev/null

# Function to install a package only if not installed
install_if_missing() {
    local pkg=$1
    if ! "$CMDLINE_PATH/sdkmanager" --sdk_root="$ANDROID_HOME" --list_installed | grep -q "^$pkg$"; then
        echo "==> Installing $pkg..."
        "$CMDLINE_PATH/sdkmanager" --sdk_root="$ANDROID_HOME" "$pkg"
    else
        echo "==> $pkg already installed, skipping."
    fi
}

# Install essential SDK packages
install_if_missing "platform-tools"
install_if_missing "platforms;android-36"

# Install build-tools only if missing
latest_build_tools=$("$CMDLINE_PATH/sdkmanager" --sdk_root="$ANDROID_HOME" --list_installed | grep "build-tools;" | awk -F';' '{print $2}' | sort -V | tail -n1)
if [ -z "$latest_build_tools" ]; then
    install_if_missing "build-tools;36.0.0"
else
    echo "==> Build Tools $latest_build_tools already installed, skipping."
fi

echo "==> Installing Terdroid..."
wget -O "$PREFIX/bin/terdroid" https://raw.githubusercontent.com/banyadm/terdroid/main/terdroid
chmod +x "$PREFIX/bin/terdroid"

echo "==> Android SDK setup complete!"
echo "Environment variables automatically added to .bashrc, .zshrc, and .profile."
echo "Restart your terminal or run 'source ~/.bashrc' or 'source ~/.zshrc' to apply."
echo "Terdroid Installed."